[Unit]
Description=Pult relay: the Telegram Mini App <-> Pult on the computer
After=network-online.target
Wants=network-online.target

[Service]
User=pult
Group=pult
# the release that runs: app/current points into app/releases/ (deploy/relay/install.sh, or the updater)
WorkingDirectory=/opt/pult-relay/app/current
# the secret: read by systemd, never by the relay (root, 600)
EnvironmentFile=/opt/pult-relay/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pult-relay/venv/bin/python relay.py
Restart=always
RestartSec=3
# the relay is small (~50 MB) and keeps nothing on disk; it yields to the rest of the server
MemoryHigh=80M
MemoryMax=120M
Nice=10
# what the relay needs is the web server on this machine: no network beyond it, no rights, no devices, nothing of the
# kernel's — the set the developer's own server has run with since 2026-10-20 (review 2026-10-27, Б11)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# its own code is read-only to it; the one place it writes: /var/lib/pult-relay, where — on a server with the updater
# (install.sh --auto, pult-relay.service.d/update.conf) — it leaves the release the computer runs
StateDirectory=pult-relay
# where it listens since 0.18.7 (PULT_RELAY_SOCKET in a new install's .env): a socket in /run/pult-relay, which only the
# relay and the web server — a member of the group pult — can enter; a free port can be taken by any program on the
# server in the seconds the relay restarts (review 2026-10-27, Б11). An install from before keeps its port.
RuntimeDirectory=pult-relay
RuntimeDirectoryMode=0750
UMask=0007

[Install]
WantedBy=multi-user.target
