[Unit]
Description=Pult relay: the Telegram Mini App <-> Pult on the computer
After=network-online.target
Wants=network-online.target

[Service]
User=pult
# the release that runs: app/current points into app/releases/ (deploy/relay/install.sh, or the updater)
WorkingDirectory=/opt/pult-relay/app/current
# the secret: read by systemd, never by the relay (root, 600)
EnvironmentFile=/opt/pult-relay/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pult-relay/venv/bin/python relay.py
Restart=always
RestartSec=3
# the relay is small (~50 MB) and keeps nothing on disk; it yields to the rest of the server
MemoryHigh=80M
MemoryMax=120M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# its own code is read-only to it; the one place it writes: /var/lib/pult-relay, where — on a server with the updater
# (install.sh --auto, pult-relay.service.d/update.conf) — it leaves the release the computer runs
StateDirectory=pult-relay

[Install]
WantedBy=multi-user.target
